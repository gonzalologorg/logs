include _bootstrap
append styles
	// Custom styles for this template
	style
		include ./css/dashboard.css
block body  
	nav.navbar.navbar-inverse.navbar-fixed-top
		.container-fluid
			.navbar-header
				button.navbar-toggle.collapsed(type='button', data-toggle='collapse', data-target='#navbar', aria-expanded='false', aria-controls='navbar')
					span.sr-only Toggle navigation
					span.icon-bar
					span.icon-bar
					span.icon-bar
				a.navbar-brand(href='#') Lua Error Viewer
			#navbar.navbar-collapse.collapse
				form.navbar-form.navbar-right
					input.form-control(type='text', placeholder='Search lua error')
	.container-fluid
		.container
			.col-sm-12
				h1.page-header History
				.table-responsive
					table.table.table-striped
						thead
							tr
								th Error
								th Addon
								th Lua File
								th Count
								th Action
						tbody
							each val, key in data
								if (val != null)
									tr
										td= val.error
										td= val.addon
										td= val.file
										td= val.count
										td
											button(onclick='move(' + key + ')') ✖
script.
	function move(id) {
		var oReq = new XMLHttpRequest();
		oReq.addEventListener("load", () =>{
			location.reload();
		});
		oReq.open("POST", "/delerror", true);
		oReq.setRequestHeader('Content-type', 'application/x-www-form-urlencoded');
		oReq.send("id=" + id);
		console.log(id);
	}